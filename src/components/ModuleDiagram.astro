---
/**
 * Card art for projects with nothing to screenshot: modules over a shared bus.
 * Decorative, so it stays out of the accessibility tree.
 */
---

<svg class="diagram" viewBox="0 0 320 180" role="presentation" aria-hidden="true">
  <!-- Consumers -->
  <rect class="diagram__node" x="30" y="26" width="68" height="30" rx="5"></rect>
  <rect class="diagram__node" x="126" y="26" width="68" height="30" rx="5"></rect>
  <rect class="diagram__node" x="222" y="26" width="68" height="30" rx="5"></rect>

  <!-- Down into the bus -->
  <path class="diagram__link" d="M64 56v26"></path>
  <path class="diagram__link" d="M160 56v26"></path>
  <path class="diagram__link" d="M256 56v26"></path>

  <!-- The shared bus -->
  <rect class="diagram__bus" x="30" y="82" width="260" height="16" rx="8"></rect>

  <!-- Down out of the bus -->
  <path class="diagram__link" d="M98 98v26"></path>
  <path class="diagram__link" d="M222 98v26"></path>

  <!-- Subscribers -->
  <rect class="diagram__node" x="54" y="124" width="88" height="30" rx="5"></rect>
  <rect class="diagram__node" x="178" y="124" width="88" height="30" rx="5"></rect>

  <circle class="diagram__joint" cx="64" cy="90" r="2.5"></circle>
  <circle class="diagram__joint" cx="160" cy="90" r="2.5"></circle>
  <circle class="diagram__joint" cx="256" cy="90" r="2.5"></circle>
</svg>

<style>
  .diagram {
    width: 100%;
    height: 100%;
    /* Breathing room, since the card crops to 16:9 around it. */
    padding: var(--space-md);
  }

  .diagram__node {
    fill: var(--surface-raised);
    stroke: var(--hairline-strong);
    stroke-width: 1.5;
  }

  .diagram__bus {
    fill: var(--accent-wash);
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .diagram__link {
    stroke: var(--hairline-strong);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .diagram__joint {
    fill: var(--accent);
  }
</style>
