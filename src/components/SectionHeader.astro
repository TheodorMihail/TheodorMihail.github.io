---
interface Props {
  /** Two-digit section index, rendered in mono alongside the title. */
  index: string;
  title: string;
  id?: string;
}

const { index, title, id } = Astro.props;
---

<div class="section-header">
  <span class="section-header__index" aria-hidden="true">{index}</span>
  <h2 id={id}>{title}</h2>
  <span class="section-header__rule" aria-hidden="true"></span>
</div>

<style>
  .section-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .section-header__index {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
    flex-shrink: 0;
  }

  .section-header h2 {
    font-size: var(--step-2);
    flex-shrink: 0;
  }

  .section-header__rule {
    flex: 1;
    align-self: center;
    height: 1px;
    background: var(--hairline);
  }
</style>
