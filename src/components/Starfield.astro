---
/**
 * Decorative backdrop. Absolutely positioned, so place it inside a
 * `position: relative` parent (the hero) rather than behind the whole
 * page: stars under body copy hurt readability.
 */
---

<div class="starfield" aria-hidden="true">
  <div class="starfield__glow"></div>
  <div class="starfield__stars"></div>
</div>

<style>
  .starfield {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    /* Fade out toward the content below so nothing sits over texture */
    mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 100%);
  }

  /* Single soft green wash, top-right */
  .starfield__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(48% 60% at 82% 0%, rgb(123 217 92 / 0.1), transparent 70%);
  }

  .starfield__stars {
    position: absolute;
    inset: -100% 0 0;
    background-repeat: repeat;
    background-image:
      radial-gradient(1.4px 1.4px at 70px 60px, rgb(242 244 248 / 0.4), transparent),
      radial-gradient(1.2px 1.2px at 290px 180px, rgb(123 217 92 / 0.35), transparent),
      radial-gradient(1.4px 1.4px at 190px 330px, rgb(242 244 248 / 0.32), transparent),
      radial-gradient(1.1px 1.1px at 380px 90px, rgb(242 244 248 / 0.24), transparent),
      radial-gradient(1.3px 1.3px at 40px 260px, rgb(242 244 248 / 0.28), transparent),
      radial-gradient(1px 1px at 230px 420px, rgb(242 244 248 / 0.2), transparent);
    background-size: 430px 430px;
    animation: drift 200s linear infinite;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, 50%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .starfield__stars {
      animation: none;
      inset: 0;
    }
  }
</style>
