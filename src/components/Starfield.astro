---
/**
 * Fixed background: two star layers at different depths plus a faint nebula wash.
 * Pure CSS — no canvas, no per-frame JS. Drift stops under prefers-reduced-motion.
 */
---

<div class="starfield" aria-hidden="true">
  <div class="stars stars--far"></div>
  <div class="stars stars--near"></div>
  <div class="nebula"></div>
</div>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: var(--canvas);
  }

  .stars {
    position: absolute;
    inset: -100% 0 0;
    background-repeat: repeat;
  }

  .stars--far {
    background-image:
      radial-gradient(1px 1px at 24px 38px, rgb(232 236 245 / 0.45), transparent),
      radial-gradient(1px 1px at 112px 90px, rgb(232 236 245 / 0.3), transparent),
      radial-gradient(1px 1px at 178px 22px, rgb(232 236 245 / 0.38), transparent),
      radial-gradient(1px 1px at 60px 156px, rgb(232 236 245 / 0.25), transparent),
      radial-gradient(1px 1px at 205px 132px, rgb(232 236 245 / 0.32), transparent),
      radial-gradient(1px 1px at 148px 190px, rgb(232 236 245 / 0.22), transparent);
    background-size: 240px 240px;
    animation: drift 260s linear infinite;
  }

  .stars--near {
    background-image:
      radial-gradient(1.6px 1.6px at 70px 60px, rgb(232 236 245 / 0.7), transparent),
      radial-gradient(1.4px 1.4px at 290px 180px, rgb(77 227 211 / 0.55), transparent),
      radial-gradient(1.6px 1.6px at 190px 330px, rgb(232 236 245 / 0.6), transparent),
      radial-gradient(1.3px 1.3px at 380px 90px, rgb(232 236 245 / 0.45), transparent),
      radial-gradient(1.5px 1.5px at 40px 260px, rgb(232 236 245 / 0.5), transparent);
    background-size: 430px 430px;
    animation: drift 150s linear infinite;
  }

  /* Very low-alpha colour so the canvas never reads as flat black */
  .nebula {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 45% at 78% -5%, rgb(77 227 211 / 0.07), transparent 70%),
      radial-gradient(55% 40% at 8% 18%, rgb(92 106 255 / 0.07), transparent 70%),
      radial-gradient(70% 50% at 50% 108%, rgb(255 77 141 / 0.05), transparent 70%);
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, 50%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stars {
      animation: none;
      inset: 0;
    }
  }
</style>
