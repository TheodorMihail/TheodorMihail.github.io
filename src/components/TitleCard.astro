---
import { Image } from 'astro:assets';
import type { Title } from '../data/titles';

interface Props {
  title: Title;
}

const { title } = Astro.props;

/**
 * Mobile screenshots are portrait and would be cropped to a thin strip by the
 * 16:9 card. Those are letterboxed over a blurred copy of themselves instead.
 */
const isPortrait = title.cover ? title.cover.width < title.cover.height : false;

/** Initials for the fallback tile shown until cover art exists. */
const initials = title.name
  .replace(/[^A-Za-z0-9 ]/g, '')
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word[0])
  .join('')
  .toUpperCase();
---

<article class="card">
  <div class:list={['card__art', isPortrait && 'card__art--portrait']}>
    {
      title.cover && isPortrait && (
        <Image
          class="card__backdrop"
          src={title.cover}
          alt=""
          aria-hidden="true"
          widths={[320]}
          sizes="340px"
          loading="lazy"
        />
      )
    }
    {
      title.cover ? (
        <Image
          class="card__image"
          src={title.cover}
          alt={`${title.name} screenshot`}
          widths={[320, 640]}
          sizes="(min-width: 60rem) 340px, (min-width: 40rem) 45vw, 90vw"
          loading="lazy"
        />
      ) : (
        <span class="card__fallback" aria-hidden="true">
          {initials}
        </span>
      )
    }
    {title.note && <span class="card__note">{title.note}</span>}
  </div>

  <div class="card__body">
    <h3 class="card__name">
      {
        title.url ? (
          <a href={title.url} rel="noopener">
            {title.name}
          </a>
        ) : (
          title.name
        )
      }
    </h3>

    <p class="card__studio">{title.studio}</p>
    <p class="card__role">{title.role}</p>
    <p class="card__blurb">{title.blurb}</p>

    <ul class="card__platforms">
      {title.platforms.map((platform) => <li>{platform}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    transition: border-color var(--transition);
  }

  .card:hover {
    border-color: var(--hairline-strong);
  }

  .card__art {
    position: relative;
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    background: var(--canvas-deep);
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
  }

  .card__art :global(.card__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Portrait source: show it whole, centred, over a blurred fill. */
  .card__art--portrait :global(.card__image) {
    position: relative;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    border-inline: 1px solid rgb(0 0 0 / 0.35);
    box-shadow: 0 0 24px rgb(0 0 0 / 0.45);
  }

  .card__art :global(.card__backdrop) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Bright enough to read as a deliberate fill rather than empty space. */
    filter: blur(14px) brightness(0.85) saturate(1.35);
    transform: scale(1.25);
  }

  .card__fallback {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--hairline-strong);
  }

  .card__note {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    flex: 1;
    padding: var(--space-md);
  }

  .card__name {
    font-size: var(--step-1);
  }

  .card__name a {
    text-decoration: none;
    color: var(--text);
  }

  .card__name a:hover {
    color: var(--accent);
  }

  .card__studio {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .card__role {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--accent);
  }

  .card__blurb {
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  /* Pinned bottom-left, so platforms line up across a row of cards. */
  .card__platforms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: auto 0 0;
    padding: var(--space-md) 0 0;
    list-style: none;
  }

  .card__platforms li {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-sm);
    background: var(--canvas-deep);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.7;
  }
</style>
