---
import Starfield from './Starfield.astro';
import { SITE } from '../consts';
---

<section class="hero">
  <Starfield />

  <div class="container hero__inner">
    <p class="kicker hero__eyebrow">Portfolio</p>

    <h1 class="hero__name">{SITE.name}</h1>

    <p class="hero__role">{SITE.role}</p>

    <p class="hero__blurb">{SITE.description}</p>

    <div class="hero__actions">
      <a class="button button--primary" href="/#work">View projects</a>
      <a class="button" href="/#contact">Get in touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(var(--space-2xl), 11vh, var(--space-3xl)) var(--space-2xl);
    border-bottom: 1px solid var(--hairline);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 52rem;
  }

  .hero__eyebrow {
    color: var(--accent);
    margin-bottom: var(--space-md);
  }

  .hero__name {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
  }

  .hero__role {
    margin-top: var(--space-sm);
    font-size: var(--step-2);
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  .hero__blurb {
    margin-top: var(--space-md);
    color: var(--text-muted);
    font-size: var(--step-1);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
</style>
