---
import Starfield from './Starfield.astro';
import { SITE, STATS } from '../consts';
---

<section class="hero">
  <Starfield />

  <div class="container hero__inner">
    <p class="kicker hero__eyebrow">{SITE.location}</p>

    <h1 class="hero__name">{SITE.name}</h1>

    <p class="hero__role">{SITE.role}</p>
    <p class="hero__tagline">{SITE.platforms}</p>

    <p class="hero__blurb">{SITE.intro}</p>

    <ul class="hero__stats">
      {
        STATS.map((stat) => (
          <li class="stat">
            <span class="stat__value">{stat.value}</span>
            <span class="stat__label">{stat.label}</span>
          </li>
        ))
      }
    </ul>

    <div class="hero__actions">
      <a class="button button--primary" href="/#work">See the work</a>
      <a class="button" href="/#contact">Get in touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(var(--space-2xl), 10vh, var(--space-3xl)) var(--space-2xl);
    border-bottom: 1px solid var(--hairline);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 52rem;
  }

  .hero__eyebrow {
    color: var(--accent);
    margin-bottom: var(--space-md);
  }

  .hero__name {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
  }

  .hero__role {
    margin-top: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  .hero__tagline {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--text-faint);
  }

  .hero__blurb {
    margin-top: var(--space-md);
    color: var(--text-muted);
    font-size: var(--step-1);
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
    padding: 0;
    list-style: none;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat__value {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    color: var(--text);
    line-height: 1.1;
  }

  .stat__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }
</style>
