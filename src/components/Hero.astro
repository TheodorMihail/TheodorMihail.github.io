---
import { SITE } from '../consts';
---

<section class="hero">
  <div class="container hero__inner">
    <p class="hero__eyebrow">Portfolio</p>

    <h1 class="hero__name">{SITE.name}</h1>

    <p class="hero__role">
      <span class="hero__cursor" aria-hidden="true"></span>
      {SITE.role}
    </p>

    <p class="hero__blurb">
      {SITE.description}
    </p>

    <div class="hero__actions">
      <a class="button button--primary" href="/#work">View projects</a>
      <a class="button" href="/#contact">Get in touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(var(--space-2xl), 12vh, var(--space-3xl)) var(--space-2xl);
  }

  .hero__inner {
    max-width: 46rem;
  }

  .hero__eyebrow {
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    line-height: 1;
    letter-spacing: 0.06em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: var(--space-lg);
  }

  .hero__name {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
  }

  .hero__role {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--accent);
  }

  .hero__cursor {
    width: 0.55rem;
    height: 1.05rem;
    background: var(--accent);
    animation: blink 1.2s steps(2, start) infinite;
  }

  .hero__blurb {
    margin-top: var(--space-md);
    max-width: 38rem;
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  @keyframes blink {
    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cursor {
      animation: none;
    }
  }
</style>
