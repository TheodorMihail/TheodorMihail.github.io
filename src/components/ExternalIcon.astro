---
/** Arrow glyph marking a link that leaves the site. Pair with a visually-hidden note. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 16 16"
  width="12"
  height="12"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M6 3h7v7"></path>
  <path d="M13 3 4 12"></path>
</svg>
