---
import ContactForm from './ContactForm.astro';
import { LINKS } from '../consts';

const channels = [
  { label: 'Email', value: LINKS.email, href: `mailto:${LINKS.email}` },
  { label: 'LinkedIn', value: 'theodor-mihail-holban', href: LINKS.linkedin },
  { label: 'GitHub', value: 'TheodorMihail', href: LINKS.github },
];
---

<div class="contact">
  <p class="contact__lead">
    Open to Unity Senior Engineering, Architecture and Technical Leadership roles.
  </p>

  <div class="contact__cols">
    <ContactForm />

    <div class="contact__direct">
      <p class="contact__direct-label">Or reach me directly</p>
      <ul class="contact__list">
        {
          channels.map((channel) => (
            <li class="contact__item">
              <span class="contact__label">{channel.label}</span>
              <a href={channel.href} rel="noopener">
                {channel.value}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .contact__lead {
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .contact__cols {
    display: grid;
    gap: var(--space-xl);
    width: 100%;
    align-items: start;
  }

  @media (min-width: 58rem) {
    .contact__cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 23rem);
    }
  }

  .contact__direct-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .contact__list {
    display: grid;
    gap: var(--space-sm);
    width: 100%;
    max-width: 34rem;
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .contact__item {
    display: grid;
    /* Narrow label column, so the email address fits on one line. */
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-sm);
    align-items: baseline;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--hairline);
  }

  .contact__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .contact__item a {
    font-size: var(--step--1);
    word-break: break-word;
  }
</style>
