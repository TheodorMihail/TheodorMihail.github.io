---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page doesn't exist." noindex>
  <section class="section lost">
    <div class="container">
      <p class="kicker lost__code">Error 404</p>
      <h1 class="lost__title">Signal lost</h1>
      <p class="lost__note">That page drifted out of range.</p>
      <a class="button button--primary" href="/">Return to base</a>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    padding-block: var(--space-3xl);
  }

  .lost__code {
    color: var(--accent);
  }

  .lost__title {
    margin-top: var(--space-sm);
    font-size: var(--step-3);
  }

  .lost__note {
    margin-top: var(--space-xs);
    margin-bottom: var(--space-lg);
    color: var(--text-muted);
  }
</style>
