---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Signal lost" description="That page doesn't exist." noindex>
  <section class="section lost">
    <div class="container">
      <p class="lost__code">404</p>
      <h1 class="lost__title">Signal lost</h1>
      <p class="lost__note">That page drifted out of range.</p>
      <a class="button button--primary" href="/">Return to base</a>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    padding-block: var(--space-3xl);
  }

  .lost__code {
    font-family: var(--font-pixel);
    font-size: clamp(1.5rem, 6vw, 2.75rem);
    line-height: 1;
    color: var(--accent);
  }

  .lost__title {
    margin-top: var(--space-md);
    font-size: var(--step-3);
  }

  .lost__note {
    margin-top: var(--space-xs);
    margin-bottom: var(--space-lg);
    color: var(--text-muted);
  }
</style>
