---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import cover from '../../assets/projects/space-invaders/gameplay.png';

/** Everything under public/, so paths are absolute from the site root. */
const BUILD = '/play/space-invaders';
const title = 'Play Space Invaders';
const description =
  'Play Space Invaders in the browser. A Unity arcade shooter with rogue-like progression and RPG systems.';
---

<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container">
      <a class="play__back" href="/projects/space-invaders/">Back to the project</a>
      <h1 class="play__title">Space Invaders</h1>

      <div class="play__stage" id="stage">
        <canvas id="unity-canvas" width="960" height="600" tabindex="-1"></canvas>

        <div class="poster" id="poster">
          <Image
            class="poster__shot"
            src={cover}
            alt="Space Invaders gameplay"
            widths={[640, 960, 1280]}
            sizes="(min-width: 70rem) 960px, 95vw"
            loading="eager"
          />
          <div class="poster__overlay">
            <div class="poster__desktop" id="poster-desktop">
              <button class="button button--primary poster__button" id="play-button" type="button">
                Play now
              </button>
              <p class="poster__note">Around 35 MB. Keyboard required.</p>
            </div>

            {/* Swapped in by script when the device looks like a phone or tablet. */}
            <div class="poster__mobile" id="poster-mobile" hidden>
              <p class="poster__mobile-note">
                Desktop and keyboard required for proper play experience.
              </p>
              <button class="button poster__try" id="try-anyway" type="button">Try anyway</button>
            </div>
          </div>
        </div>

        <div class="loading" id="loading" hidden>
          <p class="loading__label" id="loading-label">Loading 0%</p>
          <div class="loading__track">
            <div class="loading__bar" id="loading-bar"></div>
          </div>
        </div>

        <div class="failed" id="failed" hidden>
          <p class="failed__title">The build failed to load.</p>
          <p class="failed__note" id="failed-note"></p>
        </div>
      </div>

      {/* Only rendered into on ?debug=1, for diagnosing devices with no attachable console. */}
      <pre class="debug" id="debug" hidden></pre>

      <div class="play__bar">
        <button class="button" id="fullscreen-button" type="button" hidden>Fullscreen</button>
      </div>

      <div class="play__cols">
        <div>
          <h2 class="play__h2">Controls</h2>
          <dl class="controls">
            <div>
              <dt>Move</dt>
              <dd>Arrow keys or WASD</dd>
            </div>
            <div>
              <dt>Shoot</dt>
              <dd>Space, hold to keep firing</dd>
            </div>
          </dl>
        </div>

        <div>
          <h2 class="play__h2">Notes</h2>
          <ul class="notes">
            <li>Desktop browser recommended. Touch controls exist but the game is tuned for keyboard</li>
            <li>Progress is saved in the browser, so talents, loot and level stars persist between visits</li>
            <li>Clearing site data resets progression</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

{/* Inline by necessity: define:vars cannot be bundled, and the loader is a global. */}
<script is:inline define:vars={{ BUILD }}>
  const stage = document.getElementById('stage');
  const poster = document.getElementById('poster');
  const playButton = document.getElementById('play-button');
  const loading = document.getElementById('loading');
  const loadingBar = document.getElementById('loading-bar');
  const loadingLabel = document.getElementById('loading-label');
  const fullscreenButton = document.getElementById('fullscreen-button');
  const failed = document.getElementById('failed');
  const failedNote = document.getElementById('failed-note');
  const canvas = document.getElementById('unity-canvas');
  const posterDesktop = document.getElementById('poster-desktop');
  const posterMobile = document.getElementById('poster-mobile');
  const tryAnyway = document.getElementById('try-anyway');
  const debugPanel = document.getElementById('debug');

  /*
   * ?debug=1 mirrors errors onto the page. Phones have no attachable console,
   * so without this a failure on device is invisible.
   */
  const debugOn = new URLSearchParams(location.search).get('debug') === '1';

  function debugLog(label, text) {
    if (!debugOn) {
      return;
    }
    debugPanel.hidden = false;
    debugPanel.textContent += `[${label}] ${text}\n`;
  }

  if (debugOn) {
    debugLog('device', `${navigator.userAgent}`);
    debugLog('screen', `${window.innerWidth}x${window.innerHeight} dpr=${window.devicePixelRatio}`);

    window.addEventListener('error', (event) => {
      debugLog('error', `${event.message} @ ${event.filename}:${event.lineno}`);
    });
    window.addEventListener('unhandledrejection', (event) => {
      debugLog('rejection', String(event.reason));
    });

    const originalError = console.error;
    console.error = function (...args) {
      debugLog('console', args.map(String).join(' '));
      originalError.apply(console, args);
    };
  }

  function showFailure(message) {
    loading.hidden = true;
    failed.hidden = false;
    failedNote.textContent = message;
  }

  /*
   * Coarse pointer plus no hover is the reliable signal for a touch device;
   * user-agent sniffing misses tablets and lies on request-desktop-site.
   */
  const isMobile =
    window.matchMedia('(pointer: coarse) and (hover: none)').matches ||
    /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

  if (isMobile) {
    posterDesktop.hidden = true;
    posterMobile.hidden = false;
  }

  tryAnyway.addEventListener('click', () => {
    posterMobile.hidden = true;
    posterDesktop.hidden = false;
  });

  playButton.addEventListener('click', () => {
    poster.hidden = true;
    loading.hidden = false;
    stage.classList.add('is-loading');

    const script = document.createElement('script');
    script.src = `${BUILD}/Build/WebGL.loader.js`;

    script.onerror = () => {
      showFailure('The Unity loader could not be fetched. Try a reload.');
    };

    script.onload = () => {
      createUnityInstance(
        canvas,
        {
          arguments: [],
          dataUrl: `${BUILD}/Build/WebGL.data.unityweb`,
          frameworkUrl: `${BUILD}/Build/WebGL.framework.js.unityweb`,
          codeUrl: `${BUILD}/Build/WebGL.wasm.unityweb`,
          streamingAssetsUrl: `${BUILD}/StreamingAssets`,
          companyName: 'Theodor Mihail Holban',
          productName: 'Space Invaders',
          productVersion: '0.1.0',
          /* Unity routes engine-level warnings and errors here rather than to console. */
          showBanner: (message, type) => {
            debugLog(`unity-${type || 'info'}`, message);
          },
          /*
           * Required for progression to survive a reload. Unity writes to
           * persistentDataPath in memory; without this it is never flushed to
           * IndexedDB and every visit starts fresh.
           */
          autoSyncPersistentDataPath: true,
        },
        (progress) => {
          const percent = Math.round(progress * 100);
          loadingBar.style.width = `${percent}%`;
          loadingLabel.textContent = `Loading ${percent}%`;
        }
      )
        .then((unityInstance) => {
          loading.hidden = true;
          stage.classList.remove('is-loading');
          stage.classList.add('is-running');
          fullscreenButton.hidden = false;
          fullscreenButton.addEventListener('click', () => {
            unityInstance.SetFullscreen(1);
          });
        })
        .catch((message) => {
          showFailure(String(message));
        });
    };

    document.body.appendChild(script);
  });
</script>

<style>
  .play__back {
    display: inline-block;
    margin-bottom: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .play__back::before {
    content: '← ';
  }

  .play__title {
    font-size: var(--step-3);
  }

  /* Fixed 16:10 box, matching the build's 960x600, so nothing reflows on load. */
  .play__stage {
    margin-top: var(--space-lg);
    position: relative;
    aspect-ratio: 960 / 600;
    max-width: 960px;
    margin-inline: auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--canvas-deep);
    overflow: hidden;
  }

  #unity-canvas {
    display: block;
    width: 100%;
    height: 100%;
    /* Revealed once the instance is running, so the blank canvas never shows. */
    opacity: 0;
    transition: opacity 240ms var(--ease);
  }

  .play__stage.is-running #unity-canvas {
    opacity: 1;
  }

  .poster {
    position: absolute;
    inset: 0;
  }

  .poster[hidden] {
    display: none;
  }

  .poster :global(.poster__shot) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .poster__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    background: rgb(16 19 24 / 0.72);
  }

  .poster__desktop,
  .poster__mobile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    max-width: 32rem;
    padding-inline: var(--space-md);
    text-align: center;
  }

  .poster__desktop[hidden],
  .poster__mobile[hidden] {
    display: none;
  }

  .poster__button {
    font-size: var(--step-0);
    padding: 0.85rem 2rem;
  }

  .poster__note {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .poster__mobile-note {
    font-size: var(--step--1);
    color: var(--text);
  }

  .poster__try {
    font-size: var(--step--1);
  }

  .loading,
  .failed {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-lg);
    text-align: center;
  }

  .loading[hidden],
  .failed[hidden] {
    display: none;
  }

  .loading__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .loading__track {
    width: min(20rem, 70%);
    height: 4px;
    border-radius: 2px;
    background: var(--hairline-strong);
    overflow: hidden;
  }

  .loading__bar {
    width: 0%;
    height: 100%;
    background: var(--accent);
    transition: width 160ms linear;
  }

  .failed__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .failed__note {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
    overflow-wrap: anywhere;
  }

  .debug {
    max-width: 960px;
    margin: var(--space-md) auto 0;
    padding: var(--space-sm);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius);
    background: var(--canvas-deep);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-height: 20rem;
    overflow-y: auto;
  }

  .debug[hidden] {
    display: none;
  }

  .play__bar {
    display: flex;
    justify-content: center;
    margin-top: var(--space-md);
    min-height: 1px;
  }

  .play__cols {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 48rem) {
    .play__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .play__h2 {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    font-weight: 500;
  }

  .controls {
    margin-top: var(--space-md);
  }

  .controls > div {
    display: flex;
    gap: var(--space-md);
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--hairline);
  }

  .controls dt {
    flex: 0 0 6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .controls dd {
    margin: 0;
    font-size: var(--step--1);
  }

  .notes {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-md);
    padding: 0;
    list-style: none;
  }

  .notes li {
    position: relative;
    padding-left: 1.15rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .notes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: var(--accent);
  }
</style>
