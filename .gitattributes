# Normalise line endings so Windows checkouts don't produce diff noise.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ico binary

# Unity WebGL build output. These must stay byte-exact: line-ending
# normalisation silently corrupts them and the player fails to load.
*.unityweb binary
*.wasm binary
*.bundle binary
*.data binary
*.bin binary
*.hash binary
